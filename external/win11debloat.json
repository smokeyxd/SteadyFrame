    { "id": "RemoveGamingApps", "name": "Remove Xbox app and Xbox Game Bar", "presets": [], "advanced": true, "requires": ["!DualCcdX3D", "!GamePass"], "breaks": "Game Pass, Xbox app, Game Bar overlay, controller Guide button overlay" },
    { "id": "DisableGameBarIntegration", "name": "Disable Game Bar popups/controller integration", "presets": [], "advanced": true, "requires": ["!DualCcdX3D"] },
    { "id": "ForceRemoveEdge", "name": "Force-remove Microsoft Edge (not recommended by its author)", "presets": [], "advanced": true, "breaks": "Edge; apps that expect it" },
