{
  "_readme": "Win11Debloat switches (run with -Silent). 'presets' = which presets pick it by default. 'advanced' items are hidden unless you open Advanced. Flags blocked by lib/Guard.ps1 are refused. Reviewed against Win11Debloat 2026.08.24. Its default app list keeps Xbox Game Bar and the Xbox app (Game Pass).",
  "items": [
    { "id": "RemoveApps", "name": "Remove preinstalled bloat apps (Bing apps, Clipchamp, Solitaire, consumer Teams, Candy Crush, TikTok...)", "presets": ["HighEnd", "MidRange"], "breaks": "Those apps (reinstall from the Store if you want one back)" },
    { "id": "DisableTelemetry", "name": "Telemetry, tailored experiences, advertising ID off", "presets": ["HighEnd", "MidRange"] },
    { "id": "DisableBing", "name": "No Bing web results in Start search", "presets": ["HighEnd", "MidRange"] },
    { "id": "DisableSuggestions", "name": "No tips, suggestions and ads in Start/Settings/Explorer", "presets": ["HighEnd", "MidRange"] },
    { "id": "DisableLockscreenTips", "name": "No tips/ads on the lock screen", "presets": ["HighEnd", "MidRange"] },
    { "id": "DisableSettings365Ads", "name": "No Microsoft 365 ads in Settings", "presets": ["HighEnd", "MidRange"] },
    { "id": "DisableEdgeAds", "name": "No Edge ads and suggestions", "presets": ["HighEnd", "MidRange"] },
    { "id": "DisableDeviceAutoAppDownload", "name": "No automatic device app downloads", "presets": ["HighEnd", "MidRange"] },
    { "id": "DisableCopilot", "name": "Copilot off", "presets": ["HighEnd", "MidRange"] },
    { "id": "DisableRecall", "name": "Recall snapshots off", "presets": ["HighEnd", "MidRange"], "requires": ["Win11"] },
    { "id": "DisableClickToDo", "name": "Click to Do off", "presets": ["HighEnd", "MidRange"], "requires": ["Win11"] },
