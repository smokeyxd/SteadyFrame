    { "id": "RevertContextMenu", "name": "Classic right-click menu", "presets": [], "advanced": true, "requires": ["Win11"] },
    { "id": "TaskbarAlignLeft", "name": "Taskbar icons on the left", "presets": [], "advanced": true, "requires": ["Win11"] },
    { "id": "EnableDarkMode", "name": "Dark mode", "presets": [], "advanced": true },
    { "id": "ShowKnownFileExt", "name": "Show file extensions", "presets": [], "advanced": true },
    { "id": "DisableNotifications", "name": "Turn off all notifications", "presets": [], "advanced": true, "breaks": "Every toast notification (Discord, Steam, Windows)" },
