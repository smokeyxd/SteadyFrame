    { "id": "DisableNotepadAI", "name": "Notepad AI features off", "presets": ["HighEnd", "MidRange"], "requires": ["Win11"] },
    { "id": "DisableWidgets", "name": "Widgets off", "presets": ["HighEnd", "MidRange"], "requires": ["Win11"] },
    { "id": "DisableStartRecommended", "name": "No 'Recommended' section in Start", "presets": ["HighEnd", "MidRange"], "requires": ["Win11"] },
