* text=auto
# Windows scripts keep CRLF, also in GitHub's "Download ZIP"
*.bat  text eol=crlf
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.txt  text eol=crlf

# left out of release zips and GitHub's "Download ZIP": only needed for working on SteadyFrame
.gitattributes export-ignore
.gitignore     export-ignore
tests/         export-ignore
tools/         export-ignore
